{
  "manifestVersion": 2,
  "execution": "trusted-worker",
  "id": "gate-inbox",
  "name": "Gate Inbox",
  "version": "0.2.0",
  "description": "Orca の決定ゲート（確認待ち）を右サイドバーに積み、番号＋一言の回答行をまとめてコピーできるようにする。件数をステータスバーに出し、新着を通知する。",
  "license": "MIT",
  "engines": {
    "orca": ">=1.4.248"
  },
  "main": "worker/main.mjs",
  "pluginApi": 1,
  "capabilities": [
    {
      "kind": "settings:own"
    },
    {
      "kind": "storage:own"
    },
    {
      "kind": "notifications:show"
    }
  ],
  "contributes": {
    "panels": [
      {
        "id": "inbox",
        "title": "Gate Inbox",
        "icon": "bell",
        "entry": "panel/index.html",
        "ui": "html"
      }
    ],
    "commands": [
      {
        "id": "gateInbox.toggleSidebar",
        "title": "Gate Inbox: 右サイドバーを開閉",
        "action": "sidebar.right.toggle"
      }
    ],
    "statusBarItems": [
      {
        "id": "pending",
        "text": "確認待ち",
        "icon": "bell",
        "tone": "neutral",
        "tooltip": "Gate Inbox: 読み込み中",
        "command": "gateInbox.toggleSidebar"
      }
    ],
    "settings": [
      {
        "key": "environment",
        "title": "Orca サーバー",
        "description": "ゲートを読むペアリング先の名前か id。空なら保存済みの最初の環境を使う。",
        "type": "string",
        "default": ""
      },
      {
        "key": "runId",
        "title": "Run",
        "description": "この Run の確認待ちだけを表示する。空なら pending のある全 Run を並べる。",
        "type": "string",
        "default": ""
      },
      {
        "key": "refreshSeconds",
        "title": "更新間隔（秒）",
        "description": "ゲートを読み直す間隔。プラグインが有効な間、パネルを閉じていてもこの間隔で読む。",
        "type": "integer",
        "default": 20,
        "minimum": 5,
        "maximum": 600
      },
      {
        "key": "notify",
        "title": "新着をデスクトップ通知",
        "description": "新しい確認待ちが届いたらデスクトップ通知を出す。起動直後に既にあったものは通知しない。",
        "type": "boolean",
        "default": true
      }
    ]
  }
}
